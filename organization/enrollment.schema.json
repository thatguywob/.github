{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TunaOS experimental policy enrollment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "profiles"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._-]+$", "not": {"enum": [".", ".."]}},
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"enum": ["workflow-permissions", "ci-contract"]}
          }
        }
      }
    }
  }
}
